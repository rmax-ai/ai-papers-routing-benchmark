        "implementation_ideas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "research_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "experiments",
        "implementation_ideas",
        "research_questions"
      ]
